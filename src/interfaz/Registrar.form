<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="interfaz.Registrar">
  <grid id="27dc6" binding="panelRegistrar" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="412"/>
    </constraints>
    <properties>
      <background color="-13138213"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="b39e6" class="javax.swing.JLabel">
