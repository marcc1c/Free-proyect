<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="interfaz.MenuCampoBatalla">
  <grid id="27dc6" binding="panelCampoBatalla" layout-manager="BorderLayout" hgap="10" vgap="10">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-13138213"/>
      <enabled value="false"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="c62c" class="javax.swing.JLabel">
        <constraints border-constraint="North"/>
        <properties>
          <font name="Rakkas" size="48" style="1"/>
          <foreground color="-1"/>
          <horizontalAlignment value="0"/>
          <text value="Campo de batalla"/>
        </properties>
      </component>
      <grid id="48b3a" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-13138213"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="609c9" class="javax.swing.JButton" binding="buttonCampaña">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="50"/>
              </grid>
            </constraints>
            <properties>
              <background color="-16112328"/>
              <borderPainted value="false"/>
              <contentAreaFilled value="true"/>
              <focusable value="false"/>
              <font name="Vollkorn" size="18" style="1"/>
              <foreground color="-1"/>
              <text value="Campaña"/>
            </properties>
          </component>
          <component id="8268a" class="javax.swing.JButton" binding="buttonVolver">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="50"/>
              </grid>
            </constraints>
            <properties>
              <background color="-16112328"/>
              <borderPainted value="false"/>
              <contentAreaFilled value="true"/>
              <focusable value="false"/>
              <font name="Vollkorn" size="18" style="1"/>
              <foreground color="-1"/>
              <text value="Volver"/>
            </properties>
          </component>
          <vspacer id="74494">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
          </vspacer>
          <vspacer id="f9427">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
          </vspacer>
          <component id="f1234" class="javax.swing.JButton" binding="buttonTorreInfinita">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="50"/>
              </grid>
            </constraints>
            <properties>
              <background color="-16112328"/>
              <borderPainted value="false"/>
              <contentAreaFilled value="true"/>
              <focusable value="false"/>
              <font name="Vollkorn" size="18" style="1"/>
              <foreground color="-1"/>
              <text value="Torre Infinita"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
